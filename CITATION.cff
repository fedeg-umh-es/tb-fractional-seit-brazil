  - family-names: "Souza"
    name-particle: "de"
    given-names: "Amaury"
repository-code: "https://github.com/fedeg-umh-es/tb-fractional-seit-brazil"
keywords:
  - tuberculosis
  - fractional-order models
  - SEIT model
  - forecasting
  - rolling-origin evaluation
  - practical identifiability
